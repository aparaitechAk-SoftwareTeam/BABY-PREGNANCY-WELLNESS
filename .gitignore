# ==============================================================================
# AparaiTech Pregnancy Wellness - Root .gitignore
# ==============================================================================

# Dependencies (Root and all subfolders)
node_modules/
**/node_modules/
.pnp
.pnp.js

# Text files & documentation dumps
*.txt
document.txt
project.txt
docs/*.txt

# Production Builds & Bundles
dist/
**/dist/
build/
**/build/
web-build/
**/web-build/
.next/
out/
*.tsbuildinfo

# Expo & Mobile
.expo/
**/.expo/
.expo-shared/
**/.expo-shared/

# Environment Variables & Secrets
.env
.env.local
.env.*.local
.env.development
.env.test
.env.production
!.env.example

# Logs & Debugging
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Testing & Coverage
coverage/
**/coverage/
*.lcov
.nyc_output/

# OS & Editor Files
.DS_Store
Thumbs.db
Desktop.ini
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Temporary & Cache
tmp/
temp/
scratch/
.cache/
**/cache/
