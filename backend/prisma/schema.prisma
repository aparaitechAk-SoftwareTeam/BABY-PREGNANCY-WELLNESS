datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  SUPPORT
  MOTHER
  CAREGIVER
  PARTNER
  FAMILY
}

enum OtpType {
  VERIFICATION
  PASSWORD_RESET
}

model User {
  id                 String            @id @default(uuid())
  email              String            @unique
  password           String
  name               String
  role               Role              @default(MOTHER)
  isEmailVerified    Boolean           @default(false)
  isProfileCompleted Boolean           @default(false)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  otps               OtpCode[]
  profile            PregnancyProfile?
  kickSessions       KickSession[]
  waterLogs          WaterLog[]
  weightLogs         WeightLog[]
  symptomLogs        SymptomLog[]
  appointments       Appointment[]
  stepLogs           StepLog[]
  sleepLogs          SleepLog[]
  tasks              WeeklyTask[]
  notifications      Notification[]
  tickets            SupportTicket[]
  messages           TicketMessage[]
}

model OtpCode {
  id        String   @id @default(uuid())
  email     String
  code      String
  type      OtpType  @default(VERIFICATION)
  expiresAt DateTime
  createdAt DateTime @default(now())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, code])
}

model PregnancyProfile {
  id                       String    @id @default(uuid())
  userId                   String    @unique
  user                     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentWeek              Int       @default(20)
  currentDay               Int       @default(0)
  trimester                Int       @default(2)
  daysRemaining            Int?
  dueDate                  DateTime?
  calculationMethod        String?
  pregnancyType            String?   @default("SINGLE")
  nickname                 String?
  height                   Float?
  heightFt                 String?
  currentWeight            Float?
  prePregnancyWeight       Float?
  bloodGroup               String?
  motherAge                Int?
  doctorName               String?
  hospitalName             String?
  doctorPhone              String?
  nextAppointmentDate      String?
  emergencyContactName     String?
  emergencyContactRelation String?
  emergencyContactPhone    String?
  medicalNotes             String?
  preferredUnits           String?   @default("METRIC")
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
}

model KickSession {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kicks           Int
  durationSeconds Int
  reachedTen      Boolean  @default(true)
  startTime       String?
  notes           String?
  createdAt       DateTime @default(now())

  @@index([userId, createdAt])
}

model WaterLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountMl  Int
  timeStr   String?
  label     String?
  loggedAt  DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([userId, loggedAt])
}

model WeightLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weightKg  Float
  week      Int?
  dateStr   String?
  note      String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model SymptomLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  symptoms  String[]
  severity  String?
  notes     String?
  isUrgent  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model Appointment {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  doctorName      String?
  hospitalName    String?
  doctorPhone     String?
  appointmentDate DateTime
  timeStr         String?
  notes           String?
  status          String   @default("UPCOMING")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId, appointmentDate])
}

model StepLog {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  steps        Int      @default(0)
  goal         Int      @default(5000)
  distanceKm   Float    @default(0)
  caloriesKcal Float    @default(0)
  activeMinutes Int     @default(0)
  dateStr      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, dateStr])
  @@index([userId, dateStr])
}

model SleepLog {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  durationMinutes Int      @default(0)
  quality         String   @default("Restful")
  dateStr         String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, dateStr])
  @@index([userId, dateStr])
}

model WeeklyTask {
  id                String   @id @default(uuid())
  week              Int      // 1-40
  title             String
  category          String   // 'medication' | 'hydration' | 'exercise' | 'kicks' | 'nutrition' | 'planning'
  timeStr           String?
  timeOfDay         String?  // 'morning' | 'afternoon' | 'evening' | 'night'
  emoji             String?
  description       String?
  clinicalRationale String?
  isCompleted       Boolean  @default(false)
  userId            String?
  user              User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([week, userId])
}

model PregnancyContent {
  id             String   @id @default(uuid())
  week           Int      // 1-40
  title          String
  summary        String
  body           String?
  category       String   @default("baby_development")
  status         String   @default("published")
  babySize       String?  // e.g. "Banana"
  babyLength     String?  // e.g. "25.6 cm"
  babyWeight     String?  // e.g. "300 g"
  fetalHighlight String?
  maternalTip    String?
  author         String?  @default("Clinical Obstetric Board")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([week, status])
}

model Notification {
  id          String   @id @default(uuid())
  userId      String?  // null = broadcast to all
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  message     String
  category    String   @default("clinical")
  isRead      Boolean  @default(false)
  actionRoute String?
  emoji       String?  @default("🌸")
  badgeColor  String?  @default("#E11D48")
  createdAt   DateTime @default(now())

  @@index([userId, isRead])
}

model SupportTicket {
  id              String          @id @default(uuid())
  ticketNumber    String          @unique
  subject         String
  description     String
  status          String          @default("open") // open, awaiting_response, resolved, unassigned, escalated
  priority        String          @default("medium") // low, medium, high, urgent
  category        String          @default("general") // billing, technical, app_usage, account, clinical, general
  userId          String?
  user            User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName        String?
  userEmail       String?
  assignedAgent   String?
  assignedAgentId String?
  escalated       Boolean         @default(false)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  messages        TicketMessage[]

  @@index([status, priority])
  @@index([userId])
}

model TicketMessage {
  id         String        @id @default(uuid())
  ticketId   String
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId   String?
  sender     User?         @relation(fields: [senderId], references: [id], onDelete: SetNull)
  senderName String
  senderRole String        @default("support") // user, support, admin
  message    String
  createdAt  DateTime      @default(now())

  @@index([ticketId])
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  entity    String
  entityId  String?
  userId    String?
  userName  String?
  details   String?
  createdAt DateTime @default(now())

  @@index([action, entity])
}

