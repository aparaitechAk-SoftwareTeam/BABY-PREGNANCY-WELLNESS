datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  SUPPORT
  MOTHER
  PARTNER
  FAMILY
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(MOTHER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
