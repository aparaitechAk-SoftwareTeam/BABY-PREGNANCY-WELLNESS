datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  SUPPORT
  MOTHER
  CAREGIVER
  PARTNER
  FAMILY
}

enum OtpType {
  VERIFICATION
  PASSWORD_RESET
}

model User {
  id                 String            @id @default(uuid())
  email              String            @unique
  password           String
  name               String
  role               Role              @default(MOTHER)
  isEmailVerified    Boolean           @default(false)
  isProfileCompleted Boolean           @default(false)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  otps               OtpCode[]
  profile            PregnancyProfile?
}

model OtpCode {
  id        String   @id @default(uuid())
  email     String
  code      String
  type      OtpType  @default(VERIFICATION)
  expiresAt DateTime
  createdAt DateTime @default(now())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, code])
}

model PregnancyProfile {
  id                       String    @id @default(uuid())
  userId                   String    @unique
  user                     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentWeek              Int       @default(20)
  currentDay               Int       @default(0)
  trimester                Int       @default(2)
  daysRemaining            Int?
  dueDate                  DateTime?
  calculationMethod        String?
  pregnancyType            String?   @default("SINGLE")
  nickname                 String?
  height                   Float?
  heightFt                 String?
  currentWeight            Float?
  prePregnancyWeight       Float?
  bloodGroup               String?
  motherAge                Int?
  doctorName               String?
  hospitalName             String?
  doctorPhone              String?
  nextAppointmentDate      String?
  emergencyContactName     String?
  emergencyContactRelation String?
  emergencyContactPhone    String?
  medicalNotes             String?
  preferredUnits           String?   @default("METRIC")
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
}

